# .env.example
# ---- Massive.com API (formerly Polygon.io) ----
# Historical variable names and the supported legacy API domain are retained.
POLYGON_API_KEY=your_api_key_here
API_BASE_URL=https://api.polygon.io

# ---- Snowflake ----
SNOWFLAKE_ACCOUNT=your_account_id
SNOWFLAKE_USER=your_username
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=MARKET
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_S3_STAGE=MARKET.RAW.POLYGON_RAW_STAGE

# ---- Amazon S3 raw landing ----
AWS_REGION=us-east-1
AWS_PROFILE=stock-market-ingestion
AWS_S3_BUCKET=stock-market-data-pipeline-your-account-id-us-east-1
AWS_S3_PREFIX=raw/polygon/grouped-daily
# Docker Compose reads the named profile from the Git-ignored files
# keys/aws-credentials and keys/aws-config. Never commit either file.

# ---- Optional dev vars ----
PYTHONPATH=.
DBT_PROFILES_DIR=dbt/stock_analytics
